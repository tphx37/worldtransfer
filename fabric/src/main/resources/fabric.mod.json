{
  "schemaVersion": 1,
  "id": "worldtransfer",
  "version": "${version}",
  "name": "World Transfer",
  "description": "Prepare a Minecraft world for a different player to host it.",
  "authors": ["World Transfer contributors"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.worldtransfer.WorldTransferFabric"],
    "client": ["com.worldtransfer.WorldTransferClient"]
  },
  "mixins": [
    "worldtransfer.mixins.json",
    {
      "config": "worldtransfer.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3 <27",
    "java": ">=25",
    "fabric-api": "*"
  }
}
